---
// Proiectul ca o broșură răsfoită: pagini duble pe calculator, o pagină pe telefon.
import type { Proiect, Imagine } from '../data/proiecte';
import { routes, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  shelf: string;
  /** broșura unui proiect */
  p?: Proiect;
  /** sau cartea de pe pagina de start: toate proiectele, fiecare cu linkul spre broșura lui */
  start?: { proiecte: Proiect[]; link: (slug: string) => string };
}
const { lang, shelf, start } = Astro.props;
const p = (Astro.props.p ?? start!.proiecte[0]) as Proiect;

const T = {
  ro: { student: 'Student arhitect la Facultatea „Ion Mincu”', portfolio: 'Portofoliu', openBook: 'Deschide broșura', contact: 'Contact', contactText: 'Pentru colaborări sau întrebări despre proiecte, scrie-mi.', prev: 'Pagina anterioară', next: 'Pagina următoare', sound: 'Sunet', on: 'pornit', off: 'oprit', back: 'Toate proiectele', credits: 'Credite', drawings: 'Desene', place: 'Loc', year: 'An', open: 'Deschide broșura', hint: 'Dă pagina cu săgețile, cu un click pe margine sau cu degetul.', full: 'Pagina completă a proiectului' },
  en: { student: 'Architecture student at the “Ion Mincu” faculty', portfolio: 'Portfolio', openBook: 'Open the brochure', contact: 'Contact', contactText: 'For collaborations or questions about the projects, write to me.', prev: 'Previous page', next: 'Next page', sound: 'Sound', on: 'on', off: 'off', back: 'All projects', credits: 'Credits', drawings: 'Drawings', place: 'Place', year: 'Year', open: 'Open the brochure', hint: 'Turn the page with the arrow keys, a click on the edge, or a swipe.', full: 'Full project page' },
}[lang];

const known = (v: string) => !v.includes('[');

type Page =
  | { kind: 'cover' }
  | { kind: 'intro' }
  | { kind: 'text'; nr: number; titlu: string; text: string }
  | { kind: 'image'; img: Imagine; desen: boolean }
  | { kind: 'photo'; img: Imagine }
  | { kind: 'spread'; img: Imagine; half: 0 | 1 }
  | { kind: 'credits' }
  | { kind: 'home' }
  | { kind: 'proj'; q: Proiect; nr: number }
  | { kind: 'contact' }
  | { kind: 'blank' }
  | { kind: 'back' };

const pages: Page[] = [];
if (start) {
  // pagina de start: imagine–text, apoi text–imagine, alternând
  pages.push({ kind: 'home' });
  start.proiecte.forEach((q, i) => {
    const img: Page = { kind: 'photo', img: q.cover };
    const txt: Page = { kind: 'proj', q, nr: i + 1 };
    pages.push(...(i % 2 === 0 ? [img, txt] : [txt, img]));
  });
  if (pages.length % 2 === 0) pages.push({ kind: 'contact' });
  pages.push({ kind: 'back' });
} else {
pages.push({ kind: 'cover' }, { kind: 'intro' }, { kind: 'photo', img: p.macheta });
p.sectiuni.forEach((s, i) => {
  // textul pe stânga, imaginea pe dreapta
  if (pages.length % 2 === 0) pages.push({ kind: 'blank' });
  pages.push({ kind: 'text', nr: i + 1, titlu: s.titlu[lang], text: s.text[lang] });
  pages.push(s.desen ? { kind: 'image', img: s.imagine, desen: true } : { kind: 'photo', img: s.imagine });
});
// desenele late se întind pe două pagini, ca într-o broșură tipărită
const WIDE = 1.25;
for (const d of p.desene) {
  if (d.w / d.h > WIDE) {
    if (pages.length % 2 === 0) pages.push({ kind: 'blank' });
    pages.push({ kind: 'spread', img: d, half: 0 }, { kind: 'spread', img: d, half: 1 });
  } else pages.push({ kind: 'image', img: d, desen: true });
}
for (const g of p.galerie) pages.push({ kind: 'photo', img: g });
pages.push({ kind: 'credits' });
// coperta din spate trebuie să cadă pe verso-ul ultimei foi (index impar)
if (pages.length % 2 === 0) pages.push({ kind: 'blank' });
pages.push({ kind: 'back' });
}

const leaves: [Page, Page][] = [];
for (let i = 0; i < pages.length; i += 2) leaves.push([pages[i], pages[i + 1]]);
const facts = [
  { k: T.place, v: p.loc[lang] },
  { k: T.year, v: p.an },
].filter((f) => known(f.v));
---
<section class:list={['carte', { start: !!start }]} data-carte data-lang={lang} data-hover={start ? '' : undefined} aria-roledescription={lang === 'ro' ? 'carte' : 'book'} aria-label={start ? 'Tonciu Alexandra' : p.titlu[lang]}>
  <div class="stage" data-stage>
    <div class="book" data-book data-s="0">
      {leaves.map(([front, back], li) => (
        <div class="leaf" data-leaf style={`--i:${li}`}>
          {[front, back].map((pg, side) => {
            const n = li * 2 + side;
            return (
              <div class:list={['face', side ? 'back' : 'front', `k-${pg.kind}`]} data-page={n} data-skip={(pg.kind === 'spread' && pg.half === 1) || pg.kind === 'blank' ? '' : undefined}>
                {pg.kind === 'cover' && (
                  <>
                    <div class="cover-img"><img src={p.cover.src} width={p.cover.w} height={p.cover.h} alt={p.cover.alt[lang]} /></div>
                    <div class="cover-band">
                      <h1>{p.titlu[lang]}</h1>
                      <p>{p.stadiu[lang]}{known(p.loc[lang]) && <> · {p.loc[lang]}</>}</p>
                      <span class="author">Tonciu Alexandra</span>
                    </div>
                  </>
                )}
                {pg.kind === 'home' && (
                  <div class="pad col home">
                    <span class="lbl">{T.portfolio}</span>
                    <h1>Tonciu Alexandra</h1>
                    <p>{T.student}</p>
                  </div>
                )}
                {pg.kind === 'proj' && (
                  <div class="pad col">
                    <span class="lbl">{String(pg.nr).padStart(2, '0')} · {pg.q.stadiu[lang]}</span>
                    <h2 class="big">{pg.q.titlu[lang]}</h2>
                    <p class="lead">{pg.q.rezumat[lang]}</p>
                    <a class="open-link" href={start!.link(pg.q.slug)}>{T.openBook} →</a>
                  </div>
                )}
                {pg.kind === 'contact' && (
                  <div class="pad col end">
                    <span class="lbl">{T.contact}</span>
                    <p>{T.contactText}</p>
                    <a class="open-link" href={routes[lang].contact}>{T.contact} →</a>
                  </div>
                )}
                {pg.kind === 'intro' && (
                  <div class="pad col">
                    <span class="lbl">{p.stadiu[lang]}</span>
                    <h2 class="big">{p.titlu[lang]}</h2>
                    <p class="lead">{p.rezumat[lang]}</p>
                    {facts.length > 0 && (
                      <dl>{facts.map((f) => (<div><dt>{f.k}</dt><dd>{f.v}</dd></div>))}</dl>
                    )}
                  </div>
                )}
                {pg.kind === 'text' && (
                  <div class="pad col">
                    <span class="lbl">{String(pg.nr).padStart(2, '0')}</span>
                    <h2>{pg.titlu}</h2>
                    <p>{pg.text}</p>
                  </div>
                )}
                {pg.kind === 'image' && (
                  <figure class="pad fig">
                    <div class="fit"><img src={pg.img.src} width={pg.img.w} height={pg.img.h} alt={pg.img.alt[lang]} loading="lazy" decoding="async" /></div>
                    <figcaption>{(pg.img.legenda ?? pg.img.alt)[lang]}</figcaption>
                  </figure>
                )}
                {pg.kind === 'spread' && (
                  <figure class:list={['spread', pg.half ? 'r' : 'l']} data-spread={pg.half}>
                    <div class="sp-img"><img src={pg.img.src} width={pg.img.w} height={pg.img.h} alt={pg.half ? '' : pg.img.alt[lang]} loading="lazy" decoding="async" /></div>
                    <figcaption>{(pg.img.legenda ?? pg.img.alt)[lang]}</figcaption>
                  </figure>
                )}
                {pg.kind === 'photo' && (
                  <img class="bleed" src={pg.img.src} width={pg.img.w} height={pg.img.h} alt={pg.img.alt[lang]} loading="lazy" decoding="async" />
                )}
                {pg.kind === 'credits' && (
                  <div class="pad col end">
                    <span class="lbl">{T.credits}</span>
                    <dl>{p.credite.map((c) => (<div><dt>{c.rol[lang]}</dt><dd>{c.nume.replace(/\s*\[[^\]]*\]/g, '').replace(/,?\s*împreună cu colegii$/, lang === 'ro' ? ' și colegii' : ' and colleagues')}</dd></div>))}</dl>
                  </div>
                )}
                {pg.kind === 'back' && (
                  <div class="pad col back-cover">
                    <span class="author">Tonciu Alexandra</span>
                    {start ? <a href={routes[lang].contact}>{T.contact}</a> : <a href={shelf} data-nolink>{T.back}</a>}
                  </div>
                )}
                {n > 0 && pg.kind !== 'back' && pg.kind !== 'photo' && pg.kind !== 'blank' && <span class="folio">{n}</span>}
              </div>
            );
          })}
        </div>
      ))}
    </div>
  </div>

  <div class="controls">
    {start ? <span /> : <a class="ctl back" href={shelf}>← {T.back}</a>}
    <div class="nav">
      <button type="button" data-prev aria-label={T.prev}>←</button>
      <span data-count aria-live="polite">1 / {pages.length}</span>
      <button type="button" data-next aria-label={T.next}>→</button>
    </div>
    <button type="button" class="ctl" data-sound aria-pressed="false" data-on={T.on} data-off={T.off}>{T.sound}: <span>{T.off}</span></button>
  </div>
  <p class="visually-hidden">{T.hint}</p>
  {!start && <a class="visually-hidden" href={routes[lang].project(p.slug)}>{T.full}</a>}
</section>

<script>
  import { mountCarte } from '../scripts/carte';
  document.querySelectorAll<HTMLElement>('[data-carte]').forEach((el) => mountCarte(el));
</script>

<style>
  .carte { --paper: #fbfaf6; --paper-edge: #e9e4da; --pw: 400px; --ph: 533px; display: flex; flex-direction: column; height: calc(100svh - 64px); min-height: 480px; user-select: none; -webkit-user-select: none; }
  .stage { flex: 1; position: relative; overflow: hidden; perspective: 2600px; touch-action: pan-y; }
  .book { position: absolute; left: 50%; top: 50%; margin: calc(var(--ph) / -2) 0 0 calc(var(--pw) * -1); width: calc(var(--pw) * 2); height: var(--ph); transform-style: preserve-3d; transition: transform 0.9s cubic-bezier(0.45, 0.05, 0.25, 1); cursor: pointer; }
  .leaf { position: absolute; left: 50%; top: 0; width: 50%; height: 100%; transform-origin: left center; transform-style: preserve-3d; transition: transform 0.9s cubic-bezier(0.45, 0.05, 0.25, 1); }
  .leaf.flipped { transform: rotateY(-180deg); }
  .face { position: absolute; inset: 0; background: var(--paper); backface-visibility: hidden; -webkit-backface-visibility: hidden; overflow: hidden; font-size: calc(var(--pw) * 0.034); line-height: 1.5; }
  .face.back { transform: rotateY(180deg); }
  /* umbra de lângă cotor, ca la hârtie */
  .face.front::before, .face.back::before { content: ''; position: absolute; inset: 0; pointer-events: none; z-index: 2; }
  .face.front::before { background: linear-gradient(to right, rgb(0 0 0 / 0.09), transparent 7%); }
  .face.back::before { background: linear-gradient(to left, rgb(0 0 0 / 0.09), transparent 7%); }
  /* lumina care trece peste foaie cât se întoarce */
  .face::after { content: ''; position: absolute; inset: 0; pointer-events: none; z-index: 3; opacity: 0; background: linear-gradient(to right, rgb(0 0 0 / 0.18), rgb(255 255 255 / 0.12) 55%, rgb(0 0 0 / 0.06)); }
  .leaf.turning .face::after { animation: shade 0.9s ease-in-out; }
  @keyframes shade { 0% { opacity: 0; } 50% { opacity: 1; } 100% { opacity: 0; } }
  .book { filter: drop-shadow(0 18px 30px rgb(40 30 20 / 0.16)) drop-shadow(0 2px 3px rgb(40 30 20 / 0.12)); }

  .pad { position: absolute; inset: 0; padding: 9% 10%; margin: 0; }
  .col { display: flex; flex-direction: column; gap: 0.9em; }
  .lbl { font-size: 0.78em; text-transform: uppercase; letter-spacing: 0.1em; color: var(--muted); }
  .face h2 { font-size: 1.45em; }
  .face h2.big { font-size: 2.1em; margin-bottom: 0.3em; }
  .face p { margin: 0; max-width: 34em; }
  .lead { font-size: 1.08em; }
  dl { margin: auto 0 0; display: grid; gap: 0.6em; font-size: 0.9em; }
  dl div { display: grid; grid-template-columns: 7em 1fr; gap: 1em; border-top: 1px solid var(--line); padding-top: 0.5em; }
  dt { color: var(--muted); }
  dd { margin: 0; }
  .end dl { margin-top: 0.6em; }
  .fig { display: flex; flex-direction: column; gap: 0.8em; }
  .fit { flex: 1; min-height: 0; position: relative; }
  .fit img { position: absolute; inset: 0; width: 100%; height: 100%; max-width: none; object-fit: contain; }
  figcaption { font-size: 0.8em; color: var(--muted); }
  .bleed { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; max-width: none; }
  .folio { position: absolute; bottom: 4.5%; font-size: 0.72em; color: var(--muted); z-index: 1; }
  .front .folio { right: 7%; }
  .back .folio { left: 7%; }

  /* desen pe două pagini: fiecare jumătate arată partea ei din aceeași imagine */
  .spread { position: absolute; inset: 0; margin: 0; }
  .sp-img { position: absolute; top: 9%; bottom: 13%; width: calc(200% - 2 * 7%); }
  .spread.l .sp-img { left: 7%; }
  .spread.r .sp-img { right: 7%; }
  .sp-img img { width: 100%; height: 100%; object-fit: contain; max-width: none; }
  .spread figcaption { position: absolute; bottom: 6%; left: 7%; right: 18%; }
  .spread.l figcaption { visibility: hidden; }
  .front.k-spread::before, .back.k-spread::before { opacity: 0.6; }
  :global(.carte.single) .spread.l .sp-img { width: auto; right: 7%; }
  :global(.carte.single) .spread.l figcaption { visibility: visible; }
  .k-cover { background: #ece7de; }
  .cover-img { position: absolute; inset: 0 0 26% 0; overflow: hidden; }
  .cover-img img { width: 100%; height: 100%; object-fit: cover; max-width: none; animation: drift 22s ease-in-out infinite alternate; transform-origin: 60% 45%; }
  @keyframes drift { from { transform: scale(1); } to { transform: scale(1.09); } }
  .cover-band { position: absolute; inset: 74% 0 0 0; padding: 5% 9%; display: flex; flex-direction: column; gap: 0.3em; }
  .cover-band h1 { font-size: 1.7em; }
  .cover-band p { color: var(--muted); font-size: 0.85em; margin: 0; }
  .author { font-size: 0.75em; letter-spacing: 0.12em; text-transform: uppercase; margin-top: auto; }
  .k-back { background: #ece7de; }
  /* pagina de start: o singură copertă, care urcă din josul paginii */
  .k-home { background: #ece7de; }
  .home { justify-content: center; gap: 0.7em; padding: 12%; }
  .home h1 { font-size: 2.5em; line-height: 1.05; }
  .home p { color: var(--muted); font-size: 0.95em; }
  .open-link { margin-top: auto; align-self: flex-start; font-size: 0.9em; color: var(--ink); text-decoration: none; border-bottom: 1px solid currentColor; padding-bottom: 2px; }
  .start .stage { animation: rise 1.4s cubic-bezier(0.2, 0.7, 0.2, 1) both; }
  @keyframes rise { from { opacity: 0; transform: translateY(14vh); } to { opacity: 1; transform: none; } }
  .back-cover { justify-content: flex-end; }
  .back-cover a { font-size: 0.85em; color: var(--muted); }

  .controls { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 10px var(--gutter) 18px; font-size: 14px; }
  .nav { display: flex; align-items: center; gap: 14px; }
  .nav button, .ctl { font: inherit; background: none; border: 0; color: var(--ink); cursor: pointer; padding: 6px 4px; text-decoration: none; }
  .nav button { font-size: 20px; line-height: 1; padding: 6px 10px; }
  .nav button:disabled { opacity: 0.25; cursor: default; }
  [data-count] { min-width: 5.5em; text-align: center; color: var(--muted); font-variant-numeric: tabular-nums; }
  .ctl { color: var(--muted); }
  @media (max-width: 760px) {
    .face { font-size: calc(var(--pw) * 0.042); }
    .controls { font-size: 13px; }
    .controls .back { display: none; }
  }
  :global(body:has([data-carte]) .site-footer) { display: none; }
  @media (prefers-reduced-motion: reduce) { .cover-img img { animation: none; } }
</style>
