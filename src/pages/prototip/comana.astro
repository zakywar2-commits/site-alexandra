---
// Pagină de probă (nelegată din meniu): casa explodată pentru Casa 760, Comana.
import Base from '../../layouts/Base.astro';
import Explozie from '../../components/Explozie.astro';
import { routes } from '../../i18n/ui';
---
<Base lang="ro" title="Prototip: Casa 760 explodată" alt={routes.en.project('comana')}>
  <meta name="robots" content="noindex" slot="head" />
  <section class="wrap intro">
    <span class="label">Prototip</span>
    <h1>Casa 760, Comana</h1>
    <p>Derulează în jos: casa se desface pe straturi, apoi se transformă în plan. Apasă pe desen ca să vezi planul construit perete cu perete.</p>
  </section>
  <Explozie lang="ro" />
</Base>
<style>
  .intro { padding-top: 64px; padding-bottom: 24px; }
  .intro h1 { font-size: clamp(32px, 5vw, 56px); margin: 8px 0 12px; }
  .intro p { max-width: 52ch; margin: 0; }
</style>
