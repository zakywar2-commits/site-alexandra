---
import Base from '../../../layouts/Base.astro';
import Carte from '../../../components/Carte.astro';
import { proiecte } from '../../../data/proiecte';
import { withBase } from '../../../i18n/ui';
---
<Base lang="ro" title="Portofoliu (prototip)" alt={withBase('/en/prototype/start/')}>
  <meta slot="head" name="robots" content="noindex" />
  <Carte lang="ro" shelf={withBase('/prototip/carte/')} start={{ proiecte, link: (s) => withBase(`/prototip/carte/${s}/#deschide`) }} />
</Base>
