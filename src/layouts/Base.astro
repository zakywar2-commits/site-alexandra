---
import '../styles/global.css';
import '@fontsource-variable/bodoni-moda';
import '@fontsource-variable/manrope';
import '@fontsource-variable/syne';
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/fraunces';
import '@fontsource/space-mono';
import '@fontsource/dm-mono';
import '@fontsource/ibm-plex-mono';
import { t, routes, withBase, type Lang } from '../i18n/ui';

interface Props { lang: Lang; title: string; description?: string; alt: string; dark?: boolean; proto?: boolean }
const { lang, title, description = '', alt, dark = false, proto = false } = Astro.props;
const tr = t(lang);
const r = routes[lang];
const otherLang = lang === 'ro' ? 'en' : 'ro';
const path = Astro.url.pathname;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · {tr('site.name')}</title>
    {description && <meta name="description" content={description} />}
    <link rel="alternate" hreflang={otherLang} href={alt} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <slot name="head" />
    {proto && <script is:inline set:html={`try{var q=new URLSearchParams(location.search);['fundal','font'].forEach(function(k){var v=q.get(k);if(v)sessionStorage.setItem(k,v);else v=sessionStorage.getItem(k);if(v)document.documentElement.dataset[k]=v;});}catch(e){}`} />}
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
  </head>
  <body class:list={[{ dark, proto }]} style={proto ? `--tex: url(${withBase('/images/textura-var.webp')})` : undefined}>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href={r.home}>{tr('site.name')}</a>
        <nav aria-label="Principal">
          <a href={r.home} aria-current={path === r.home ? 'page' : undefined}>{tr('nav.projects')}</a>
          <a href={r.contact} aria-current={path === r.contact ? 'page' : undefined}>{tr('nav.contact')}</a>
          <a class="lang" href={alt} hreflang={otherLang} lang={otherLang}>{otherLang.toUpperCase()}</a>
        </nav>
      </div>
    </header>
    <main><slot /></main>
    {proto && (
      <div class="proba" aria-label="Variante de încercat">
        <button type="button" data-proba="font">Font</button>
        <button type="button" data-proba="fundal">Fundal</button>
      </div>
      <script is:inline set:html={`(function(){var V={font:[['b','Archivo'],['a','Syne'],['c','Fraunces'],['bodoni','Bodoni']],fundal:[['verde','Verde'],['dark-miami','Dark Miami'],['oliveblack','Oliveblack'],['inkedjapan','Inkedjapan++'],['midnight-vendetta','Midnight V.'],['car-coat','Car Coat']]};var d=document.documentElement;function cur(k){return d.dataset[k]||V[k][0][0];}function label(){document.querySelectorAll('[data-proba]').forEach(function(b){var k=b.dataset.proba,c=cur(k),n=V[k].find(function(x){return x[0]===c;});b.textContent=(k==='font'?'Font: ':'Fundal: ')+(n?n[1]:c)+' →';});}document.querySelectorAll('[data-proba]').forEach(function(b){b.addEventListener('click',function(){var k=b.dataset.proba,l=V[k],i=l.findIndex(function(x){return x[0]===cur(k);});var n=l[(i+1)%l.length][0];d.dataset[k]=n;try{sessionStorage.setItem(k,n);}catch(e){}label();});});label();})();`} />
    )}
    <footer class="site-footer">
      <div class="wrap bar">
        <span>© {new Date().getFullYear()} {tr('site.name')}. {tr('footer.rights')}</span>
        <a href={r.contact}>{tr('nav.contact')}</a>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header { position: sticky; top: 0; z-index: 10; background: color-mix(in srgb, var(--bg) 92%, transparent); backdrop-filter: blur(6px); border-bottom: 1px solid var(--line); }
  .bar { display: flex; justify-content: space-between; align-items: center; gap: 16px; min-height: 64px; }
  .brand { text-decoration: none; font-weight: 500; white-space: nowrap; }
  @media (max-width: 480px) { .brand { font-size: 15px; } nav { gap: 12px; } }
  nav { display: flex; gap: clamp(14px, 3vw, 32px); align-items: center; }
  nav a { text-decoration: none; font-size: 15px; }
  nav a[aria-current='page'] { text-decoration: underline; text-underline-offset: 6px; }
  .lang { border: 1px solid currentColor; padding: 2px 8px; font-size: 13px !important; letter-spacing: 0.06em; }
  .site-footer { border-top: 1px solid var(--line); margin-top: 96px; font-size: 14px; color: var(--muted); }
  .site-footer .bar { flex-wrap: wrap; padding: 16px 0; }
</style>
